# Super Dodge Ball (USA) — cheats.
#
# FORMAT: RetroArch's .cht. `cheats = N`, then cheatN_desc / cheatN_code /
# cheatN_enable. A code may hold several codes joined by any of + , ; . _ or a
# space, and the spellings are the ones every NES libretro core accepts, so a
# file from libretro-database drops straight in:
#
#   AAAA:VV      freeze AAAA to VV every frame      (RAM; a write)
#   AAAA?CC:VV   write VV while AAAA still reads CC (RAM; conditional)
#   AAAA:VV      above $8000, substitute VV for the value read at AAAA
#   8 hex digits Pro Action Replay / GameShark. The LEADING byte is discarded:
#                bbbbAAAAVV -> address AAAA, value VV.
#   6 or 8 chars Game Genie, alphabet APZLGITYEOXUKSVN. A read substitution.
#                The 8-character form carries a compare, tested ONCE when the
#                cheat is armed.
#
# IMPORTANT for this ROM: the recompiler turns an opcode into a goto and an
# address operand into a compile-time constant, so no cheat here can change an
# instruction or retarget it. Immediates and data operands are read at run time
# and DO respond. See src/sdb_cheats.c.
#
# Every entry below ships DISABLED, exactly as libretro-database ships it: the
# file is a menu, not a decision. Nothing here is armed until you say so.
#
# PROVENANCE: the thirteen entries below come from libretro-database's file for
# this ROM (all thirteen, all disabled, all of enable = false there too). They
# are UNVERIFIED: RetroArch's own forums note the database is auto-generated and
# untested, and the four health codes are literally labelled "Possibility 1-4"
# upstream. They are here to be measured, not because they are known good.
#
# Codes written for this project go below those thirteen, under their own
# heading. Each entry says where it came from; that is all the credit a short
# functional code needs. See NOTICE.md for the upstream project's licence.

cheats = 13

# ---- from libretro-database, all unverified ----
cheat0_desc = "P1 Team Modifier"
cheat0_code = "007B:80"
cheat0_enable = false

