dist/
build/

# NES frame output
**/nes_frames/
**/ppu_output/

# Comparison output
recomp_output/
nes_reference/
comparison_results.csv

# MesenCE configuration (separate from submodule)
config/

# Screenshots
**/screenshots/
**/Screenshots/

# Scratch test artifacts (scripts, dumps, screenshots from debugging)
tmp/

# TAS harness per-run artifacts (regenerated by tools/tas/run_tas.py)
tas/runs/
# Canonical TAS JSON (regenerated by tools/tas/bk2_to_tas.py from tas/vectors/)
tas/*.tas.json
# Mesen raw frame dumps (P6 screenshots from oracle/TAS scripts)
*.ppm
